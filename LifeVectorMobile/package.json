{
  "name": "lifevectormobile",
  "version": "2.0.0",
  "private": true,
  "description": "LifeVector mobile tracker for securely collecting LifePi location records over Bluetooth.",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
